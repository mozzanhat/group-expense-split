// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Bảng lưu thông tin người dùng
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())

  // Quan hệ: 1 User có thể tạo nhiều Group (Đã đặt tên "GroupCreator")
  groupsCreated Group[] @relation("GroupCreator")

  // Quan hệ: 1 User có thể tham gia nhiều GroupMember
  memberships GroupMember[]

  // Quan hệ: 1 User có thể trả nhiều Expense (Đã đặt tên "ExpensePayer")
  expensesPaid Expense[] @relation("ExpensePayer")
}

// Bảng lưu thông tin nhóm
model Group {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  // Quan hệ: 1 Group được tạo bởi 1 User (Khớp tên "GroupCreator" với bảng User)
  creatorId Int
  creator   User   @relation("GroupCreator", fields: [creatorId], references: [id])

  // Quan hệ: 1 Group có nhiều GroupMember
  members GroupMember[]

  // Quan hệ: 1 Group có nhiều Expense
  expenses Expense[]
}

// Bảng nối User và Group (Quan hệ nhiều-nhiều)
model GroupMember {
  joinedAt DateTime @default(now())

  // Quan hệ: 1 GroupMember thuộc về 1 User
  userId Int
  user   User @relation(fields: [userId], references: [id])

  // Quan hệ: 1 GroupMember thuộc về 1 Group
  groupId Int
  group   Group @relation(fields: [groupId], references: [id])

  // Khóa chính phức hợp: đảm bảo 1 user chỉ ở trong 1 group 1 lần
  @@id([userId, groupId])
}

// Bảng lưu các khoản chi tiêu------------------------------------------
model Expense {
  id          Int      @id @default(autoincrement())
  description String
  amount      Float    // Số tiền
  profit      Float    @default(0) // Tiền lời (nếu có)
  
  // --- QUAN TRỌNG: Cột Hạn Trả ---
  dueDate     DateTime? 
  
  isConfirmed Boolean  @default(false)
  createdAt   DateTime @default(now())
  
  groupId     Int
  group       Group    @relation(fields: [groupId], references: [id])
  
  paidById    Int
  // ✅ ĐÃ SỬA: Thêm "ExpensePayer" vào đây để khớp với bảng User
  paidBy      User     @relation("ExpensePayer", fields: [paidById], references: [id])
}