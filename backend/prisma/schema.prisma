// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Bảng lưu thông tin người dùng
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String?
  name      String?
  
  // --- CÁC TRƯỜNG MỚI ---
  username      String?  @unique // Tên đăng nhập
  phone         String?  // Số điện thoại
  address       String?  // Địa chỉ
  gender        String?  // Nam/Nữ/Khác
  dob           DateTime? // Ngày sinh
  cccd          String?   // Căn cước công dân
  bankAccount   String?   // Số tài khoản ngân hàng
  bankBin       String?   // Mã BIN ngân hàng
  bankName      String?   // Tên ngân hàng (Lưu tên cho dễ hiển thị)
  
  // ... Các trường cũ giữ nguyên
  googleId      String?  @unique
  avatar        String?
  expenses      Expense[]     @relation("ExpensePayer")
  groupMembers  GroupMember[]
  expenseSplits ExpenseSplit[]
  createdAt     DateTime @default(now())
  createdGroups Group[] @relation("GroupCreator")
}

// Bảng lưu thông tin nhóm
model Group {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  // Quan hệ: 1 Group được tạo bởi 1 User (Khớp tên "GroupCreator" với bảng User)
  creatorId Int
  creator   User   @relation("GroupCreator", fields: [creatorId], references: [id])

  // Quan hệ: 1 Group có nhiều GroupMember
  members GroupMember[]

  // Quan hệ: 1 Group có nhiều Expense
  expenses Expense[]
}

// Bảng nối User và Group (Quan hệ nhiều-nhiều)
model GroupMember {
  joinedAt DateTime @default(now())

  // Quan hệ: 1 GroupMember thuộc về 1 User
  userId Int
  user   User @relation(fields: [userId], references: [id])

  // Quan hệ: 1 GroupMember thuộc về 1 Group
  groupId Int
  group   Group @relation(fields: [groupId], references: [id])

  // Khóa chính phức hợp: đảm bảo 1 user chỉ ở trong 1 group 1 lần
  @@id([userId, groupId])
}

// Bảng lưu các khoản chi tiêu------------------------------------------
// ... Các model User, Group giữ nguyên ...

// ... (User, Group giữ nguyên)

model Expense {
  id          Int      @id @default(autoincrement())
  description String
  amount      Float
  profit      Float    @default(0)
  dueDate     DateTime?
  
  // 1. Trạng thái thanh toán (Cũ: dùng để xác nhận đã trả nợ xong chưa)
  isConfirmed Boolean  @default(false) 
  
  // 2. MỚI: Trạng thái duyệt của nhóm (Hàng chờ vs Hàng chính)
  // false = Hàng chờ (Pending), true = Hàng chính (Active)
  isApproved  Boolean  @default(false)

  createdAt   DateTime @default(now())
  
  groupId     Int
  group       Group    @relation(fields: [groupId], references: [id])
  paidById    Int
  paidBy      User     @relation("ExpensePayer", fields: [paidById], references: [id])
  splits      ExpenseSplit[] 
}

model ExpenseSplit {
  expenseId Int
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId    Int
  user      User    @relation(fields: [userId], references: [id])

  // 3. MỚI: Người này có phải trả tiền lời không?
  paysProfit Boolean @default(false)

  // 4. MỚI: Người này đã bấm Đồng ý chưa?
  hasApproved Boolean @default(false)

  amount      Float   @default(0)

  @@id([expenseId, userId])
}